# DevPilot AI Environment Variables Blueprint

# App General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend - FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_in_production_secret_key_123456789

# Database - PostgreSQL + pgvector Configuration
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot_password
POSTGRES_DB=devpilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devpilot:devpilot_password@postgres:5432/devpilot_db

# LLM & AI Framework Configuration (PydanticAI / Providers)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# Frontend - Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
