# DevPilot AI Environment Variables Blueprint
# Copy to .env and fill in real values. Never commit .env.

# App General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend - FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_me_in_production_min_32_chars
CORS_EXTRA_ORIGINS=
JWT_SECRET_KEY=change_me_in_production_min_32_chars

# Database - PostgreSQL + pgvector Configuration
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot_password
POSTGRES_DB=devpilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devpilot:devpilot_password@postgres:5432/devpilot_db

# LLM & AI Framework Configuration (PydanticAI / Providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend - Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
