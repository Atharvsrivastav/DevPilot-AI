# DevPilot AI Environment Variables Blueprint
# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# App General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend - FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Required in production (>= 32 random characters). Never commit real values.
SECRET_KEY=
JWT_SECRET_KEY=
CORS_EXTRA_ORIGINS=
FRONTEND_URL=http://localhost:3000

# Demo mode is local-only and must stay false in production.
ALLOW_DEMO_AUTH=false
# The server-wide GitHub PAT must not be used for private repositories until
# per-user authorization exists.
ALLOW_PRIVATE_REPOS=false

# Abuse limits
MAX_CONCURRENT_ANALYSES=2
MAX_QUEUED_ANALYSES=20
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXPENSIVE_REQUESTS=10
RATE_LIMIT_EXPENSIVE_WINDOW_SECONDS=60

# Database - PostgreSQL + pgvector Configuration
POSTGRES_USER=devpilot
# Replace with a strong, unique password (required by docker-compose).
POSTGRES_PASSWORD=
POSTGRES_DB=devpilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devpilot:replace_with_strong_password@postgres:5432/devpilot_db

# LLM & AI Framework Configuration (PydanticAI / Providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_MAX_FALLBACK_MODELS=2
NVIDIA_REQUEST_TIMEOUT_SECONDS=30

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Frontend - Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
