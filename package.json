{
  "name": "devpilot-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev -- -H 0.0.0.0",
    "dev:frontend": "npm --prefix frontend run dev -- -H 0.0.0.0",
    "dev:backend": "uv run --directory backend uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "uv run --directory backend pytest",
    "lint:backend": "uv run --directory backend ruff check ."
  }
}
